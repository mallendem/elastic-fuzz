# libFuzzer dictionary for the ES|QL parser fuzzer.
# One token per line, quoted. libFuzzer auto-loads <fuzzer>.dict from the
# fuzzer's directory, and build.sh copies this to $OUT/esql.dict. Seeding the
# mutator with ES|QL keywords/operators lets it reach deep grammar states far
# faster than random byte flips.

# Source commands
"FROM"
"ROW"
"SHOW"
"EXPLAIN"

# Processing commands
"WHERE"
"STATS"
"EVAL"
"DISSECT"
"GROK"
"ENRICH"
"MV_EXPAND"
"LIMIT"
"SORT"
"KEEP"
"DROP"
"RENAME"
"LOOKUP"
"FORK"

# Clauses / keywords
"BY"
"ASC"
"DESC"
"ON"
"WITH"
"AS"
"METADATA"
"NULLS FIRST"
"NULLS LAST"

# Boolean / comparison operators
"AND"
"OR"
"NOT"
"LIKE"
"RLIKE"
"IN"
"IS NULL"
"IS NOT NULL"
"TRUE"
"FALSE"
"NULL"

# Common functions
"COUNT"
"COUNT_DISTINCT"
"AVG"
"SUM"
"MIN"
"MAX"
"MEDIAN"
"PERCENTILE"
"CASE"
"DATE_TRUNC"
"DATE_FORMAT"
"DATE_PARSE"
"TO_STRING"
"TO_INT"
"TO_INTEGER"
"TO_LONG"
"TO_DOUBLE"
"TO_BOOLEAN"
"TO_DATETIME"
"LENGTH"
"SUBSTRING"
"CONCAT"
"SPLIT"
"COALESCE"
"TRIM"
"REPLACE"
"ABS"
"ROUND"
"FLOOR"
"CEIL"
"GREATEST"
"LEAST"
"STARTS_WITH"
"ENDS_WITH"

# Punctuation / operators
"|"
","
"("
")"
"["
"]"
"=="
"!="
">="
"<="
">"
"<"
"="
"+"
"-"
"*"
"/"
"%"
"."
":"
";"
"\""
"?"
"::"
